    var P=`<path d='M10 80C70 0 210 -20 300 75C210 160 70 160 10 80Z'/><path d='M290 75L385 22C368 55 368 95 385 130Z'/>`;
    m=mk('');m.id='md';
    m.innerHTML=`<div class='card'><button class='x'>×</button><svg class='fish' viewBox='0 -10 400 190'><defs><clipPath id='fc'><rect id='fr' x='0' y='-10' width='400' height='190'/></clipPath></defs><g id='fg' fill='#cfcfcf'>`+P+`</g><g id='ff' fill='#78c0b4' clip-path='url(#fc)'>`+P+`</g><circle cx='80' cy='64' r='11' fill='#fff'/><circle id='rd' cx='385' cy='22' r='14' fill='#e53935'/></svg><hr><div class='lb' id='lb'></div></div>`;
    document.body.appendChild(m);
    m.onclick=function(e){if(e.target===m||e.target.className==='x')m.className=''};
  }
  var full=v>=100,r=$('fr'),lb='';
  $('fg').setAttribute('fill',full?'#e29696':'#cfcfcf');
  $('ff').setAttribute('fill',full?'#e29696':'#78c0b4');
  $('rd').style.display=full?'':'none';
  var SG=STG[w]||STG['*']||STAGES;for(var i=0;i<SG.length;i++){if(v>=SG[i][0]){lb=SG[i][1];break}}
  $('lb').textContent='['+lb+']';
  r.style.transition='none';r.style.transform='translateY(190px)';
  m.className='on';r.getBoundingClientRect();
  r.style.transition='transform 1.1s ease-out';r.style.transform='translateY('+(190*(1-v/100))+'px)';
}
function snap(id){hs.push({id:id,n:evs.length,aff:Object.assign({},aff),cv:Object.assign({},cv),gap:gap,extra:extra,last:last})}
function back(k){
  var j=hs.length-k;if(j<0)return;var s=hs[j];run++;hs.length=j+1;
  $('log').innerHTML='';$('ui').innerHTML='';$('end').innerHTML='';
  rec=false;last=null;cv={};
  evs.slice(0,s.n).forEach(function(e){
    if(e.k==='o'){cv[e.l.w]=e.v;addOther(e.l)}
    else if(e.k==='m')addMe(e.t);
    else if(e.k==='d')addDiv();
    else if(e.k==='n')addNote(e.t);
    else if(e.k==='p'){cv[e.w]=e.v;if(last===e.w)last=null}
  });
  rec=true;evs.length=s.n;
  aff=Object.assign({},s.aff);cv=Object.assign({},s.cv);gap=s.gap;extra=s.extra;last=s.last;
  var cs=$('log').querySelectorAll('.col');lastCol=cs[cs.length-1];
  showUI(S[s.id]);
}
function start(){run++;last=null;aff={};cv={};gap=dflt;extra=0;evs=[];hs=[];rec=true;$('log').innerHTML='';$('ui').innerHTML='';$('end').innerHTML='';
  if(first)play(first);else $('log').textContent='스토리를 먼저 써 주세요.'}
function slots(p){
  var box=$('slots');box.innerHTML='';
  p.chars.map(function(c){return['av:'+c,c+' 프로필']}).concat(p.avs.map(function(a){return['av:'+a,a.replace(':',' · ')+' 프로필']})).concat(p.imgs.map(function(i){return['img:'+i,'이미지: '+i]})).forEach(function(x){
    var l=document.createElement('label'),s=document.createElement('span'),f=document.createElement('input');
    s.textContent=x[1]+(over[x[0]]?' ✓':'');f.type='file';f.accept='image/*';
    f.onchange=function(){var file=f.files[0];if(!file)return;var rd=new FileReader();
      rd.onload=function(){over[x[0]]=rd.result;s.textContent=x[1]+' ✓';
        document.querySelectorAll('[data-slot]').forEach(paint)};rd.readAsDataURL(file)};
    l.appendChild(s);l.appendChild(f);box.appendChild(l)});
}
function apply(){
  var v=$('src').value,p=parse(v);S=p.S;STG=p.stg;dflt=p.dflt;first=p.first;save(v);slots(p);
  $('warn').textContent=p.miss.length?'⚠ 없는 장면으로 연결됨: '+p.miss.join(', ')+' (그 선택지는 끝으로 처리돼요)':'';
}
function tab(n){$('pl').style.display=n===1?'block':'none';$('ed').style.display=n===2?'block':'none';
  $('t1').className=n===1?'on':'';$('t2').className=n===2?'on':'';if(n===1)window.scrollTo(0,0)}
function exportHtml(){
  apply();
  var data=JSON.stringify({src:$('src').value,over:over}).split('<').join(String.fromCharCode(92)+'u003c');
  var css=document.querySelector('style').textContent,js=document.getElementById('code').textContent;
  var h='<!DOCTYPE html><html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><title>'+document.title+'</title><style>'+css+'</style></head><body><div id="app"><div id="pl"><div id="log"></div><div id="ui"></div><div id="end"></div></div></div><script id="code">window.VN_EMBED='+data+';'+js+'<'+'/script></body></html>';
  var o=$('out');o.style.display='block';o.value=h;o.select();try{document.execCommand('copy')}catch(e){}
  try{var a=document.createElement('a');a.href=URL.createObjectURL(new Blob([h],{type:'text/html'}));a.download='index.html';document.body.appendChild(a);a.click();a.remove()}catch(e){}
}
$('log').onclick=function(e){var t=e.target;if(t.className==='av')showFish(t.dataset.slot.split(':')[1])};
if(EMB){over=EMB.over||{};var p0=parse(EMB.src);S=p0.S;STG=p0.stg;dflt=p0.dflt;first=p0.first;start()}
else{
  $('t1').onclick=function(){apply();tab(1);start()};
  $('t2').onclick=function(){run++;tab(2)};
  $('go').onclick=function(){apply();tab(1);start()};
  $('exp').onclick=exportHtml;
  $('src').value=load()||SAMPLE;
  apply();start();
}
</script></body></html>
